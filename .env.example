# Gemini API — the only text/image provider the Story Factory uses.
GEMINI_API_KEY=your_gemini_api_key_here

# Cron Secret (generate with: openssl rand -hex 32)
# verifyCronAuth falls open in development when unset — always set it in deployed envs.
CRON_SECRET=your_cron_secret_here

# Story Factory master switch. Must be exactly "true" for any writing to happen.
# See docs/STORY_FACTORY.md.
STORY_FACTORY_ENABLED=false

# Used ONLY by the ai-authors feature (src/services/ai-provider.ts), when an admin
# explicitly selects a deepseek-* model there. The Story Factory writer never uses
# it — provider.ts is Gemini-only with no fallback.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Notes:
# - .env.local is gitignored and should contain your actual keys for local development
# - For Vercel production, add these same variables in the Vercel dashboard
# - NEXT_PUBLIC_* variables are exposed to the browser (use for client-side code)
# - SUPABASE_SERVICE_ROLE_KEY is server-only (never expose to client)
